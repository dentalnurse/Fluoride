rules_version = '2';
// Storage rules for the CPD Hub's Firebase project (pictures and videos).
// Paste into Firebase Console → Storage → Rules, then Publish.
service firebase.storage {
  match /b/{bucket}/o {
    match /media/{file} {
      function isAdmin() {
        return request.auth != null && (
          request.auth.token.email.lower() in ['emily@dentalnurse.training', 'erica@dentalnurse.training'] ||
          firestore.exists(/databases/(default)/documents/admins/$(request.auth.token.email.lower())));
      }
      allow read: if true;
      allow create, update: if isAdmin()
        && (request.resource.contentType.matches('image/.*') && request.resource.size < 10 * 1024 * 1024
         || request.resource.contentType.matches('video/.*') && request.resource.size < 100 * 1024 * 1024);
      allow delete: if isAdmin();
    }
  }
}
