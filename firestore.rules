rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /learners/{uid} {
      allow read, write: if request.auth != null &&
        (request.auth.uid == uid ||
         request.auth.token.email == 'emily@dentalnurse.training' ||
         request.auth.token.email == 'erica@dentalnurse.training');
    }

    match /supervisorAgreements/{token} {
      allow get: if true;
      allow list: if request.auth != null &&
        (request.auth.token.email == 'emily@dentalnurse.training' ||
         request.auth.token.email == 'erica@dentalnurse.training');
      allow create: if request.auth != null;
      allow update: if true;
      allow delete: if request.auth != null &&
        (request.auth.token.email == 'emily@dentalnurse.training' ||
         request.auth.token.email == 'erica@dentalnurse.training');
    }

    match /logbookSignoffs/{token} {
      allow get: if true;
      allow list: if request.auth != null &&
        (request.auth.token.email == 'emily@dentalnurse.training' ||
         request.auth.token.email == 'erica@dentalnurse.training');
      allow create: if request.auth != null;
      allow update: if true;
      allow delete: if request.auth != null &&
        (request.auth.token.email == 'emily@dentalnurse.training' ||
         request.auth.token.email == 'erica@dentalnurse.training');
    }

    match /courseContent/{doc} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        (request.auth.token.email == 'emily@dentalnurse.training' ||
         request.auth.token.email == 'erica@dentalnurse.training');
    }

    match /ecRequests/{docId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null &&
        (request.auth.token.email == 'emily@dentalnurse.training' ||
         request.auth.token.email == 'erica@dentalnurse.training');
    }

    match /pendingEnrolments/{email} {
      allow create: if true;
      allow update: if true;
      allow get: if request.auth != null &&
        (request.auth.token.email == email ||
         request.auth.token.email == 'emily@dentalnurse.training' ||
         request.auth.token.email == 'erica@dentalnurse.training');
      allow list: if request.auth != null &&
        (request.auth.token.email == 'emily@dentalnurse.training' ||
         request.auth.token.email == 'erica@dentalnurse.training');
      allow delete: if request.auth != null &&
        (request.auth.token.email == 'emily@dentalnurse.training' ||
         request.auth.token.email == 'erica@dentalnurse.training');
    }

  }
}
